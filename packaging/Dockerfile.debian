FROM debian:13
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake ninja-build pkg-config python3 ca-certificates curl file patchelf zip zstd desktop-file-utils appstream dbus-daemon qt6-base-dev qt6-declarative-dev qt6-tools-dev qt6-tools-dev-tools qt6-l10n-tools libkf6globalaccel-dev libkf6statusnotifieritem-dev libkscreen-dev libkscreen-bin libddcutil-dev qml6-module-qtquick qml6-module-qtquick-controls qml6-module-qtquick-layouts qml6-module-qtquick-window qml6-module-qtquick-templates qml6-module-qtqml-workerscript libgl1-mesa-dri qt6-wayland qt6-wayland-dev-tools qml6-module-qtqml-models && rm -rf /var/lib/apt/lists/*
WORKDIR /work
